# ---------------------------------------------------------------------------
# Local development (copy to .env.local)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://todo:todo@localhost:5433/todo
JWT_SECRET=dev-secret-change-in-production
APP_URL=http://localhost:3000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Docker Compose (copy to .env in project root — all three are required)
# ---------------------------------------------------------------------------
POSTGRES_USER=todo
POSTGRES_PASSWORD=todo
POSTGRES_DB=todo
POSTGRES_PORT=5433
APP_PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
APP_URL=http://localhost:3000

# Set TRUST_PROXY=true when behind Cloudflare Tunnel or a reverse proxy
# TRUST_PROXY=true
