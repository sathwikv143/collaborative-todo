# ---------------------------------------------------------------------------
# Local development (copy to .env.local)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://todo:todo@localhost:5433/todo
JWT_SECRET=dev-secret-change-in-production
APP_URL=http://localhost:3000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Docker Compose (copy to .env in project root — all three are required)
# ---------------------------------------------------------------------------
POSTGRES_USER=todo
POSTGRES_PASSWORD=todo
POSTGRES_DB=todo
POSTGRES_PORT=5433
# Port published on the NAS/host (left side of the mapping). App listens on 3000 inside the container.
APP_PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
# Public URL users open in the browser — port must match APP_PORT (unless using HTTPS on 443).
APP_URL=http://localhost:3000

# Set TRUST_PROXY=true when behind Cloudflare Tunnel or a reverse proxy
# TRUST_PROXY=true
